[
{
"id": 0,
"kind": "s",
"text": "Pradžios Miestas"
},
{
"id": 1,
"kind": "s",
"text": "Spalvinga, linksma ir gyva."
},
{
"id": 2,
"kind": "s",
"text": "Pagrindinis kelionių ir pasaulio tyrinėjimo centras."
},
{
"id": 3,
"kind": "s",
"text": "Begalinė Dykuma"
},
{
"id": 4,
"kind": "s",
"text": "Karšta, sausa ir paslaptinga."
},
{
"id": 5,
"kind": "s",
"text": "Nuolat judančios smėlio kopos ir paslėpti griuvėsiai."
},
{
"id": 6,
"kind": "s",
"text": "Šalta, rami ir paslaptinga."
},
{
"id": 7,
"kind": "s",
"text": "Milžiniški ledo urvai ir paslaptingas pasaulis po ledu."
},
{
"id": 8,
"kind": "s",
"text": "Grybų Karalystė"
},
{
"id": 9,
"kind": "s",
"text": "Spalvinga, linksma ir keista."
},
{
"id": 10,
"kind": "s",
"text": "Milžiniški grybai sudaro beveik visą kraštovaizdį."
},
{
"id": 11,
"kind": "s",
"text": "Sausa, laukinė ir paslaptinga."
},
{
"id": 12,
"kind": "s",
"text": "Raudonas smėlis ir didžiulės požeminės oazės."
},
{
"id": 13,
"kind": "s",
"text": "Džiunglės"
},
{
"id": 14,
"kind": "s",
"text": "Laukinė, drėgna ir gyvybinga."
},
{
"id": 15,
"kind": "s",
"text": "Tanki augmenija, paslaptingos šventyklos ir daugybė gyvybės."
},
{
"id": 16,
"kind": "s",
"text": "Pikselių Pasaulis"
},
{
"id": 17,
"kind": "s",
"text": "Linksma, keista ir nenuspėjama."
},
{
"id": 18,
"kind": "s",
"text": "Viskas sudaryta iš pikselių, o fizika čia keista."
},
{
"id": 19,
"kind": "s",
"text": "Kūrėjo Salė"
},
{
"id": 20,
"kind": "s",
"text": "Mistinė, didinga ir nepaaiškinama."
},
{
"id": 21,
"kind": "s",
"text": "Pasaulio centras ir didžiausia jo paslaptis."
},
{
"id": 22,
"kind": "t",
"text": "uniform vec3 uTop,uHor,uUp,uCam,uSun; uniform float uTime; varying vec3 vW;\n  void main(){ vec3 v=normalize(vW-uCam); vec3 n=normalize(vW);\n    float e=dot(v,uUp);\n    vec3 zen=uTop*0.78;\n    vec3 col=mix(uHor,zen,pow(smoothstep(-0.02,0.9,e),0.7));\n    col=mix(col,uHor*1.06,exp(-max(e,0.)*9.)*0.6);\n    float s=max(dot(v,uSun),0.);\n    col+=vec3(1.,.93,.78)*(pow(s,900.)*7.+pow(s,60.)*.35+pow(s,8.)*.12);\n    float f=pow(1.0-abs(dot(v,n)),3.);\n    vec3 ir=0.5+0.5*cos(6.2831*(f*1.3+dot(n,vec3(.3,.5,.2))*0.6+vec3(0.,.33,.67))+uTime*0.2);\n    col=mix(col,ir,clamp(f*0.25,0.,0.22));\n    gl_FragColor=vec4(col,1.); }"
},
{
"id": 23,
"kind": "s",
"text": "Kūrėjo vartai"
},
{
"id": 24,
"kind": "s",
"text": "Seni ženklai"
},
{
"id": 25,
"kind": "s",
"text": "Aikštės grindinyje iškalti septyni švytintys simboliai. Kiekvienas rodo į skirtingą pasaulio pusę, o aštuntojo vietoje – tuščia dėmė. Kažkas jį ištrynė."
},
{
"id": 26,
"kind": "s",
"text": "Seni griuvėsiai"
},
{
"id": 27,
"kind": "s",
"text": "Smėlio nugairintos kolonos. Ant vienos išraižytas tas pats simbolis, kurį matei Pradžios Mieste. Kažkas čia buvo seniai prieš miestą."
},
{
"id": 28,
"kind": "s",
"text": "Niekas nežino, kas pastatė šiuos vartus ir kur jie veda. Pro juos pučia vėjas, nors kitoje pusėje vėjo nėra. Kartais tarp kolonų sužiba mėlyna šviesa."
},
{
"id": 29,
"kind": "s",
"text": "Oazė"
},
{
"id": 30,
"kind": "s",
"text": "Mažas vandens telkinys tarp palmių. Vanduo šaltas, nors aplink karšta. Panašu, kad jis ateina iš labai giliai."
},
{
"id": 31,
"kind": "s",
"text": "Požeminis tunelis"
},
{
"id": 32,
"kind": "s",
"text": "Tamsus įėjimas po smėliu. Iš gilumos sklinda tylus ūžimas, lyg kažkas po žeme kvėpuotų."
},
{
"id": 33,
"kind": "s",
"text": "Viduje stovi stalas su dviem puodeliais. Arbata seniai užšalusi. Atrodo, kad gyventojai išėjo labai skubėdami."
},
{
"id": 34,
"kind": "s",
"text": "Milžiniškas ledo urvas. Sienos permatomos, o giliai jose sustingę burbulai, panašūs į mažus pasaulius. Gal tai kiti burbulai, kaip tavasis?"
},
{
"id": 35,
"kind": "s",
"text": "Šešėlis po ledu"
},
{
"id": 36,
"kind": "s",
"text": "Po vandeniu lėtai plaukia kažkas didelio. Kai pasilenki arčiau, šešėlis sustoja, lyg klausytųsi. Tada nuplaukia toliau."
},
{
"id": 37,
"kind": "s",
"text": "Šio biomo širdis. Jo kepurė šviečia tuo ryškiau, kuo daugiau sporų aplink. Aplink kamieną spirale kyla lentyniniai grybai – galima užlipti iki pat viršaus."
},
{
"id": 38,
"kind": "s",
"text": "Kaulų statinys"
},
{
"id": 39,
"kind": "s",
"text": "Milžiniški kaulai, išsikišę iš raudono smėlio. Bet jie per lygūs ir per tvarkingi – lyg kažkas juos ne užkasė, o pastatė."
},
{
"id": 40,
"kind": "s",
"text": "Požeminė oazė"
},
{
"id": 41,
"kind": "s",
"text": "Pro plyšį matosi žalia šviesa. Po raudonu smėliu – didžiulis vandens ežeras, o aplink jį auga augalai, kurie šviečia patys."
},
{
"id": 42,
"kind": "s",
"text": "Senovinė šventykla"
},
{
"id": 43,
"kind": "s",
"text": "Akmeninė šventykla, kurią beveik prarijo džiunglės. Viršuje – tamsus įėjimas, o ant sienų tas pats aštuonių spindulių ženklas. Šventykla seniai laukia, kol kas nors užlips."
},
{
"id": 44,
"kind": "s",
"text": "Šventyklos viršūnė"
},
{
"id": 45,
"kind": "s",
"text": "Tamsoje matosi piešinys: mažas žalias žmogeliukas stovi priešais didžiulę šviesą. Ar tai tu?"
},
{
"id": 46,
"kind": "s",
"text": "Paslėptas krioklys"
},
{
"id": 47,
"kind": "s",
"text": "Vanduo krenta iš niekur – uolos viršuje nėra jokios upės. Už vandens sienos girdisi tylus dūzgimas."
},
{
"id": 48,
"kind": "s",
"text": "Plūduriuojantys akmenys"
},
{
"id": 49,
"kind": "s",
"text": "Akmenys kabo ore ir šiek tiek siūbuoja. Fizika čia keista: gali užlipti jais kaip laiptais."
},
{
"id": 50,
"kind": "s",
"text": "Vanduo, tekantis į viršų"
},
{
"id": 51,
"kind": "s",
"text": "Kvadratiniai vandens lašai kyla aukštyn ir dingsta ore. Kažkur viršuje turbūt yra kitas ežeras – apverstas."
},
{
"id": 52,
"kind": "s",
"text": "Kelias niekada nebūna toje pačioje vietoje. Plytelės šokinėja iš vienos pusės į kitą, lyg nežinotų, kur turėtų vesti."
},
{
"id": 53,
"kind": "s",
"text": "Pikselių vartai"
},
{
"id": 54,
"kind": "s",
"text": "Vartai į nebaigtą pasaulio vietą. Viduje mirga juodi ir rožiniai kvadratai – tekstūros dar neužkrautos. Tai vieta, kurios Kūrėjas dar nespėjo pabaigti."
},
{
"id": 55,
"kind": "s",
"text": "Dėžė"
},
{
"id": 56,
"kind": "s",
"text": "Statinė"
},
{
"id": 57,
"kind": "s",
"text": "Žuvis"
},
{
"id": 58,
"kind": "s",
"text": "Senovinė moneta"
},
{
"id": 59,
"kind": "s",
"text": "Sniego gniūžtė"
},
{
"id": 60,
