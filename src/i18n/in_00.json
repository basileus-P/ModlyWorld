},
{
"id": 83,
"kind": "s",
"text": "Aukštas siauras bokštas su smailia viršūne."
},
{
"id": 84,
"kind": "s",
"text": "Baltos sienos ir didžiulė dėmėta kepurė."
},
{
"id": 85,
"kind": "s",
"text": "Sniego namelis. Viduje stebėtinai šilta."
},
{
"id": 86,
"kind": "s",
"text": "Pikselių namas"
},
{
"id": 87,
"kind": "s",
"text": "Kvadratinis ir spalvotas, kaip iš Pikselių Pasaulio."
},
{
"id": 88,
"kind": "s",
"text": "Didelis namas su kolonomis prie įėjimo."
},
{
"id": 89,
"kind": "s",
