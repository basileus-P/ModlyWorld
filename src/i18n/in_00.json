},
{
"id": 71,
"kind": "s",
"text": "Skrenda per dangų… ir krenta"
},
{
"id": 72,
"kind": "s",
"text": "Milžinų ataka!"
},
{
"id": 73,
"kind": "s",
"text": "Žemė dreba. Laikykis atokiau nuo jo kojų."
},
{
"id": 74,
"kind": "s",
"text": "Daiktų lietus!"
},
{
"id": 75,
"kind": "s",
"text": "Iš dangaus krenta visokie daiktai"
},
{
"id": 76,
"kind": "s",
"text": "Garsas: išj. (M)"
},
{
"id": 77,
